#!/bin/sh
set -eu

skill_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -z "${UV_CACHE_DIR:-}" ]; then
  UV_CACHE_DIR="${TMPDIR:-/tmp}/html2doc-skill-uv-cache"
  export UV_CACHE_DIR
fi
if ! command -v uv >/dev/null 2>&1; then
  echo "html2doc setup: uv is required. Install it from https://docs.astral.sh/uv/." >&2
  exit 1
fi
UV_PROJECT_ENVIRONMENT="$skill_root/.venv"
export UV_PROJECT_ENVIRONMENT
uv python install 3.12
uv --project "$skill_root" sync --managed-python --python 3.12
exec uv --project "$skill_root" run --no-sync html2doc "$@"
