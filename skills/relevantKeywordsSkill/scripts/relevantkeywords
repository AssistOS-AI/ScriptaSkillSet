#!/bin/sh
set -eu

skill_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -z "${UV_CACHE_DIR:-}" ]; then
  UV_CACHE_DIR="${TMPDIR:-/tmp}/relevantkeywords-skill-uv-cache"
  export UV_CACHE_DIR
fi
if ! command -v uv >/dev/null 2>&1; then
  echo "relevantkeywords setup: uv is required. Install it from https://docs.astral.sh/uv/." >&2
  exit 1
fi
UV_PROJECT_ENVIRONMENT="$skill_root/.venv"
UV_PYTHON_INSTALL_DIR="$skill_root/.python"
ORT_DISABLE_TELEMETRY=1
export UV_PROJECT_ENVIRONMENT UV_PYTHON_INSTALL_DIR ORT_DISABLE_TELEMETRY
uv python install --no-bin --no-registry 3.12
uv --project "$skill_root" sync --managed-python --python 3.12
exec uv --project "$skill_root" run --no-sync relevantkeywords "$@"
